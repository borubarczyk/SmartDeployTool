#!/bin/sh

echo "[Pre-commit] Generowanie zanonimizowanego pliku config.example.json..."

# Uruchamiamy narzędzie PowerShell (ścieżka względem głównego folderu repozytorium)
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "SmartDeployTool/Create-ConfigExample.ps1"

# Dodajemy świeżo wygenerowany plik do aktualnego commita, by upewnić się, że wyślemy jego najnowszą wersję
if [ -f "SmartDeployTool/config.example.json" ]; then
    git add "SmartDeployTool/config.example.json"
fi