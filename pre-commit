#!/bin/sh
# Hook pre-commit: przed każdym commitem generuje zanonimizowany config.example.json.
# Instalacja (jednorazowo, z katalogu repozytorium):
#   cp pre-commit .git/hooks/pre-commit
# Git uruchamia hooki z katalogu głównego repozytorium, więc ścieżki są względem niego
# (wcześniej wskazywały nieistniejący podkatalog "SmartDeployTool/").

echo "[Pre-commit] Generowanie zanonimizowanego pliku config.example.json..."

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "Create-ConfigExample.ps1"

# Dodajemy świeżo wygenerowany plik do aktualnego commita, by upewnić się, że wyślemy jego najnowszą wersję
if [ -f "config.example.json" ]; then
    git add "config.example.json"
fi
